digraph system {
graph [rankdir=TB,bgcolor="transparent",pad="0.2",nodesep="0.3",ranksep="0.3"];
node [shape=box,style="rounded,filled",fillcolor="#F0F6FA",color="#A4BEC9",fontname="Arial",fontsize=11,margin="0.12,0.1"];
edge [color="#527989",fontname="Arial",fontsize=9,arrowsize=.7];
experience [label="User Experience Database"];
jd [label="Target Job Description"];
sections [label="Section / Experience Record Parsing\nPreserving Company, Role, Time, and Source"];
parse [label="Structured JD Parsing\nJob Objectives / Responsibilities / KSA"];
chunks [label="Chunking by Experience Record\nSource Information Retained per Chunk"];
queries [label="Medium Granularity Task Queries"];
retrieve [label="Embedding + Keyword Hybrid Ranking\nRecall Quotas by Experience Group"];
atoms [label="Selected Original Text → Experience Atoms\nSTAR / KSA Annotation, No New Facts Added"];
match [label="Quality Check and JD Matching"];
score [label="Programmatic Coverage and Suitability Scoring\nModel Explanation Results"];
follow [label="Gap-Based Follow-up Question Plan\nUser Responses → Understanding and Attribution Review"];
resume [label="Final Generation\nEvidence Original Text + Valid Supplement as Factual Basis",fillcolor="#DDEEF5"];
output [label="Separate Fields: Text / Optimization Suggestions"];
experience -> sections -> chunks -> retrieve;
jd -> parse -> queries -> retrieve;
retrieve -> atoms -> match -> score -> follow -> resume -> output;
sections -> resume [label="Direct Context like Education / Skills",style=dashed];
retrieve -> resume [label="Selected Original Text Evidence",style=dashed];
score -> resume [label="Can Generate Directly Without Supplement",style=dashed];
}
