digraph flow {
graph [rankdir=TB, bgcolor="transparent", pad="0.2", nodesep="0.24", ranksep="0.34"];
node [shape=box,style="rounded,filled",fillcolor="#F0F6FA",color="#A4BEC9",fontname="Arial",fontsize=12,margin="0.16,0.11"];
edge [color="#527989",fontname="Arial",fontsize=10,arrowsize=.7];
input [label="Input Experience Database and Target JD"];
analysis [label="JD Parsing → Experience Retrieval → Matching and Gap Analysis"];
summary [label="View Match Summary and Evidence"];
choice [shape=diamond,label="Supplement Further?",fillcolor="#E3F3EF"];
question [label="Display Current High-Value Follow-Up Question"];
answer [label="User Submits Response"];
review [label="Review Additional Facts and Experience Attribution"];
next [shape=diamond,label="Continue Answering?",fillcolor="#E3F3EF"];
generate [label="Generate Resume Body and Independent Optimization Suggestions",fillcolor="#DDEEF5"];
view [label="View Body and Suggestions Separately"];
export [label="Download Markdown / Word\nContaining Resume Body Only"];
input -> analysis -> summary -> choice;
choice -> question [label="Have Questions, Willing to Answer"];
choice -> generate [label="No Questions / Generate Directly"];
question -> answer -> review;
question -> next [label="Skip Current Question"];
review -> generate [label="Finish Supplementing, Generate Resume",color="#0E7890",penwidth=2];
review -> next [label="Continue Supplementing"];
next -> question [label="More Questions"];
next -> generate [label="No More Answers / Completed"];
generate -> view -> export;
}
